# SwasthyaSetu AI - Environment Configuration Example

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to absolute SQLite local DB)
# For PostgreSQL in staging/production:
# DATABASE_URL=postgresql://user:password@localhost:5432/swasthyasetu
DATABASE_URL=sqlite:///./swasthyasetu.db

# National Health Stack / ABDM Simulation Keys (Mocked for Demo)
ABDM_CLIENT_ID=demo_abdm_client_id
ABDM_CLIENT_SECRET=demo_abdm_client_secret
ESANJEEVANI_GATEWAY_URL=https://mock.esanjeevani.gov.in/v1

# AI / LLM Optional Fallback Provider (Deterministic fallback is active by default)
OPENAI_API_KEY=optional_mock_or_real_key
AI_MODEL_NAME=gpt-4o-mini-mock

# Emergency Dispatch Gateway
NATIONAL_EMERGENCY_HELPLINE=112
AMBULANCE_DISPATCH_HELPLINE=108

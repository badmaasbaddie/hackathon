# SwasthyaSetu AI - environment configuration example (copy to .env or set in your shell)

# Database (defaults to backend/swasthyasetu.db)
# DATABASE_URL=sqlite:///./swasthyasetu.db

# Put real values in a file named .env next to this one (it is git-ignored and
# loaded automatically when the server starts).

# AI assistant (optional). Without a key the assistant runs in a clearly labelled
# demo mode: deterministic safety screening + retrieved reference text.
# ANTHROPIC_API_KEY=your-key-here
# AI_MODEL_NAME=claude-opus-5-5
# AI_ASSISTANT_MODE=fallback   # force demo mode even when a key is set

# National integrations are simulated in this prototype; no keys are needed.

# Read-aloud voices (optional). With a key, answers are spoken by ElevenLabs in
# Hindi, Marathi and English; without one the browser's own voices are used.
# The key stays on the server and is never sent to the browser.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # built-in "Sarah"; library voices need a paid plan
# ELEVENLABS_MODEL_ID=eleven_v4_turbo   # or eleven_v4 for slightly higher quality but slower

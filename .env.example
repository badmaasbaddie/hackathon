# SwasthyaSetu AI - environment configuration example (copy to .env or set in your shell)

# Database (defaults to backend/swasthyasetu.db)
# DATABASE_URL=sqlite:///./swasthyasetu.db

# AI assistant (optional). Without a key the assistant runs in a clearly labelled
# demo mode: deterministic safety screening + retrieved reference text.
# ANTHROPIC_API_KEY=your-key-here
# AI_MODEL_NAME=claude-opus-5-5
# AI_ASSISTANT_MODE=fallback   # force demo mode even when a key is set

# National integrations are simulated in this prototype; no keys are needed.
